---
/**
 * Apartados sueltos: Colaboradores, Contacto, Participa, Calendario… (src/content/paginas/).
 * Se editan, crean y eliminan desde la web en modo edición.
 */
import Layout from '../layouts/Layout.astro';
import { getPaginas, BASE } from '../lib/data';
import { renderPagina } from '../lib/render';
import { contacto } from '../data/contacto';

export async function getStaticPaths() {
	return (await getPaginas()).map((p) => ({ params: { slug: p.id }, props: { id: p.id } }));
}
const { id } = Astro.props as { id: string };
const p = (await getPaginas()).find((x) => x.id === id)!;
---

<Layout title={p.data.titulo} description={p.data.intro}>
	<div id="page-root" data-kind="paginas" data-id={id} set:html={renderPagina(p.data, { base: BASE })} />

	{/* Bloques fijos de algunos apartados (no se editan aquí: los datos de contacto están en src/data/contacto.ts) */}
	{id === 'contacto' && (
		<div class="wrap gp-extra">
			<dl class="gp-contact">
				<div><dt>Correo</dt><dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd></div>
				<div><dt>Dirección</dt><dd>{contacto.direccion}<br />{contacto.escuela}</dd></div>
				<div><dt>Redes</dt><dd>{contacto.redes.map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}</dd></div>
			</dl>
		</div>
	)}
	{id === 'calendario' && (
		<div class="wrap gp-extra"><a class="btn primary" href={contacto.redes[0].url} target="_blank" rel="noopener">Ver novedades en Instagram <span class="arr">→</span></a></div>
	)}
	{id === 'participa' && (
		<div class="wrap gp-extra"><a class="btn primary" href={`mailto:${contacto.email}?subject=Quiero%20participar%20en%20Reset`}>Escribir a {contacto.email} <span class="arr">→</span></a></div>
	)}
	<div class="gp-end"></div>
</Layout>
