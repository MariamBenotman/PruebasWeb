---
/** Páginas fijas heredadas de la web antigua (definidas en src/data/paginas.ts). */
import Layout from '../layouts/Layout.astro';
import { paginas, hijasDe, contacto, type Pagina } from '../data/paginas';
import { href } from '../lib/data';
import { md } from '../lib/render';

export function getStaticPaths() {
	return paginas.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Pagina };
const hijas = hijasDe(p.slug);
const padre = p.slug.includes('/') ? paginas.find((x) => x.slug === p.slug.split('/').slice(0, -1).join('/')) : undefined;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title={p.titulo} description={p.intro}>
	<div class="wrap gp">
		<header class="pg-head">
			<p class="kicker">{padre ? <a href={href(padre.slug)}>{padre.titulo}</a> : <span>{p.seccion}</span>}<span>{p.titulo}</span></p>
			<h1 class="display gp-t">{p.titulo}</h1>
			<p class="lede gp-lede">{p.intro}</p>
		</header>

		{p.cuerpo && <div class="prose gp-body" set:html={md(p.cuerpo)} />}

		{p.slug === 'contacto' && (
			<dl class="gp-contact">
				<div><dt>Correo</dt><dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd></div>
				<div><dt>Dirección</dt><dd>{contacto.direccion}<br />{contacto.escuela}</dd></div>
				<div><dt>Redes</dt><dd>{contacto.redes.map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}</dd></div>
			</dl>
		)}
		{p.slug === 'calendario' && (
			<p class="gp-body"><a class="btn primary" href={contacto.redes[0].url} target="_blank" rel="noopener">Ver novedades en Instagram <span class="arr">→</span></a></p>
		)}
		{p.slug === 'participa' && (
			<p class="gp-body"><a class="btn primary" href={`mailto:${contacto.email}?subject=Quiero%20participar%20en%20Reset`}>Escribir a {contacto.email} <span class="arr">→</span></a></p>
		)}

		{hijas.length > 0 && (
			<ul class="gp-kids">
				{hijas.map((h, i) => (
					<li class="reveal" style={`--d:${i}`}>
						<a href={href(h.slug)}>
							<span class="idx">{pad(i + 1)}</span>
							<h2>{h.titulo}</h2>
							<p>{h.intro}</p>
							<span class="gp-arr" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</Layout>

<style>
	.gp { padding-bottom: 6rem; }
	.gp-t { font-size: clamp(2.6rem, 7vw, 5.8rem); }
	.gp-lede { max-width: 56ch; margin-top: 1.8rem; }
	.kicker a { text-decoration: none; }
	.kicker a + span::before { content: '/'; margin-right: .9rem; color: var(--naranja); }
	.gp-body { margin-bottom: 3rem; }
	.gp-contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin: 0; border: 1px solid var(--negro); background: var(--blanco); }
	.gp-contact div { padding: 1.4rem; border-right: 1px solid var(--linea); }
	.gp-contact div:last-child { border-right: 0; }
	.gp-contact dt { font-family: var(--f-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--naranja); margin-bottom: .5rem; }
	.gp-contact dd { margin: 0; display: flex; flex-direction: column; gap: .2rem; }
	.gp-contact a { color: var(--azul); }
	.gp-kids { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.4rem; margin: 0; padding: 0; list-style: none; }
	.gp-kids a { position: relative; display: block; height: 100%; padding: 1.5rem 1.5rem 3.2rem; border: 1px solid var(--negro); background: var(--blanco); text-decoration: none; transition: transform .2s var(--ease), box-shadow .2s var(--ease); }
	.gp-kids a:hover { transform: translate(-3px, -3px); box-shadow: var(--sombra); }
	.gp-kids h2 { margin: .6rem 0 .4rem; font-size: 1.3rem; }
	.gp-kids p { margin: 0; color: var(--gris); font-size: .93rem; }
	.gp-arr { position: absolute; left: 1.5rem; bottom: 1.1rem; color: var(--naranja); }
</style>
