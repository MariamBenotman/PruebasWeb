---
import Layout from '../layouts/Layout.astro';
import { getCursos, getEdiciones, getNoticias, href, fecha } from '../lib/data';

const [ediciones, cursos, noticias] = await Promise.all([getEdiciones(), getCursos(), getNoticias()]);
const ct = ediciones[0];
const curso = cursos[0];
const ultimas = noticias.slice(0, 3);
const img = (p?: string) => (p ? (/^(https?:|\/)/.test(p) ? p : href(p)) : '');

const areas = [
	{ n: '01', t: 'Robótica', d: 'Robots autónomos y teleoperados, de la idea al pabellón de competición.' },
	{ n: '02', t: 'Electrónica', d: 'Diseño de circuitos, soldadura, sensores y PCBs hechas en casa.' },
	{ n: '03', t: 'Automática', d: 'Control, sistemas embebidos y todo lo que hace que algo se mueva bien.' },
	{ n: '04', t: 'Informática', d: 'Programación, visión, web y lo que haga falta para que funcione.' },
];
const servicios = [
	{ t: 'Proyectos', d: 'Proyectos propios en los que cualquiera puede meterse.', u: 'proyectos' },
	{ t: 'Talleres', d: 'Formación totalmente gratuita: Arduino, C, soldadura, diseño de robots.', u: 'talleres' },
	{ t: 'Impresión 3D', d: 'Servicio exclusivo para alumnado y personal de la ETSII.', u: 'servicios/impresion-3d' },
	{ t: 'Préstamos', d: 'Herramientas a tu disposición para que no se pare tu proyecto.', u: 'servicios/prestamos' },
];
---

<Layout>
	<section class="hero">
		<div class="wrap hero-in">
			<div class="hero-copy">
				<p class="kicker"><span>Asociación de estudiantes</span><span>ETSII · UPM</span></p>
				<h1 class="display hero-t">
					<span class="ln"><span>Tocar,</span></span>
					<span class="ln"><span>entender</span></span>
					<span class="ln"><span>y <em>construir.</em></span></span>
				</h1>
				<p class="hero-lede">Muchos entramos en la carrera queriendo convertirnos en MacGyver. Si tienes ganas de cacharrear, Reset es tu sitio: proyectos propios, talleres gratuitos y la competición de robótica más grande de la UPM.</p>
				<div class="hero-cta">
					{ct && <a class="btn primary" href={ct.url}>{ct.label} <span class="arr">→</span></a>}
					<a class="btn" href={href('participa')}>Únete a Reset <span class="arr">→</span></a>
				</div>
			</div>
			<div class="hero-art">
				<figure class="frame hero-photo" data-label="Reset">
					<img src={href('fotos/inicio/portada.jpg')} alt="Miembros de Reset en el taller" onerror="__img(this)" fetchpriority="high" />
				</figure>
				<svg class="trace" viewBox="0 0 220 140" aria-hidden="true">
					<path d="M2 20 H90 L120 50 V110 H218" />
					<circle cx="2" cy="20" r="4" /><circle cx="120" cy="80" r="3" /><circle cx="218" cy="110" r="4" />
				</svg>
				<p class="hero-tag"><span class="idx">REF.</span> Taller Reset · ETSII</p>
			</div>
		</div>
	</section>

	<section class="areas">
		<div class="wrap areas-in">
			{areas.map((a, i) => (
				<div class="area reveal" style={`--d:${i}`}>
					<span class="idx">{a.n}</span>
					<h2>{a.t}</h2>
					<p>{a.d}</p>
				</div>
			))}
		</div>
	</section>

	<section class="wrap about">
		<header class="sec-head reveal"><span class="idx">§01</span><h2>Quiénes somos</h2><span class="rule"></span></header>
		<div class="about-in">
			<p class="about-big reveal">Una asociación <em>sin ánimo de lucro</em> donde el conocimiento se comparte libremente entre todos los miembros y cualquiera con ganas de aprender.</p>
			<div class="prose reveal" style="--d:2">
				<p>Reset pertenece a la ETSII-UPM y se dedica a la robótica, la electrónica, la automática y la informática. Realizamos proyectos propios, organizamos competiciones, representamos a la Universidad Politécnica de Madrid en eventos e impartimos talleres totalmente gratuitos.</p>
				<p>Además, ofrecemos un servicio de impresión 3D y préstamo de herramientas exclusivo para el alumnado y el personal de la ETSII. Para todo ello contamos con el apoyo de varios departamentos, unidades docentes y otras asociaciones.</p>
				{curso && <p><a href={curso.url}>Conoce al equipo del curso {curso.data.curso} →</a></p>}
			</div>
		</div>
	</section>

	{ct && (
		<section class="ct-band">
			<div class="ct-band-grid" aria-hidden="true"></div>
			<div class="wrap ct-band-in">
				<div>
					<p class="kicker on-dark"><span>Competición</span><span>Edición {ct.data.anio}</span></p>
					<h2 class="ct-band-t">Cyber<br />tech<span>{String(ct.data.anio).slice(2)}</span></h2>
				</div>
				<div class="ct-band-r">
					<p class="ct-band-lema">{ct.data.lema || 'La competición de robótica más grande de la UPM.'}</p>
					{ct.data.categorias.length > 0 && (
						<ul class="ct-band-cats">{ct.data.categorias.map((c, i) => <li><span class="idx">{String(i + 1).padStart(2, '0')}</span>{c.nombre}</li>)}</ul>
					)}
					<a class="btn primary" href={ct.url}>Ver las pruebas <span class="arr">→</span></a>
					<p class="ct-band-hist">Ediciones anteriores: {ediciones.slice(1).map((e) => <a href={e.url}>{e.data.anio}</a>)}</p>
				</div>
			</div>
		</section>
	)}

	<section class="wrap services">
		<header class="sec-head reveal"><span class="idx">§02</span><h2>Qué hacemos</h2><span class="rule"></span></header>
		<div class="svc-grid">
			{servicios.map((s, i) => (
				<a class="svc reveal" style={`--d:${i}`} href={href(s.u)}>
					<span class="idx">{String(i + 1).padStart(2, '0')}</span>
					<h3>{s.t}</h3>
					<p>{s.d}</p>
					<span class="svc-arr" aria-hidden="true">→</span>
				</a>
			))}
		</div>
	</section>

	{ultimas.length > 0 && (
		<section class="wrap news">
			<header class="sec-head reveal"><span class="idx">§03</span><h2>Noticias</h2><span class="rule"></span><a class="more" href={href('noticias')}>Todas →</a></header>
			<div class="news-grid">
				{ultimas.map((n, i) => (
					<a class="news-card reveal" style={`--d:${i}`} href={href(`noticias/${n.id}`)}>
						<figure class="frame" data-label={n.data.category ?? 'Reset'}>
							{n.data.image && <img src={img(n.data.image)} alt="" loading="lazy" onerror="__img(this)" />}
						</figure>
						<p class="news-meta"><time datetime={n.data.pubDate.toISOString()}>{fecha(n.data.pubDate)}</time>{n.data.category && <span>{n.data.category}</span>}</p>
						<h3>{n.data.title}</h3>
					</a>
				))}
			</div>
		</section>
	)}

	<section class="join">
		<div class="wrap join-in">
			<h2 class="display">¿Te <em>apuntas?</em></h2>
			<div>
				<p>Ser miembro de Reset es gratis. Ven a construir, enseñar, organizar Cybertech o simplemente a pasarlo bien y hacer amigos.</p>
				<a class="btn" href={href('participa')}>Quiero participar <span class="arr">→</span></a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero { padding: clamp(2.5rem, 7vw, 6rem) 0 clamp(3rem, 7vw, 5rem); border-bottom: 1px solid var(--negro); overflow: hidden; }
	.hero-in { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem 4rem; align-items: center; }
	.hero-t { font-size: clamp(2.3rem, 5.7vw, 5.2rem); }
	.ln { display: block; overflow: hidden; padding-bottom: .04em; }
	.ln > span { display: inline-block; animation: rise .9s var(--ease) both; }
	.ln:nth-child(2) > span { animation-delay: .08s; }
	.ln:nth-child(3) > span { animation-delay: .16s; }
	@keyframes rise { from { transform: translateY(105%); } }
	.hero-lede { max-width: 50ch; margin: 2rem 0 2.2rem; font-size: 1.12rem; color: #3b3a36; animation: fade 1s var(--ease) .35s both; }
	.hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; animation: fade 1s var(--ease) .45s both; }
	@keyframes fade { from { opacity: 0; transform: translateY(10px); } }
	.hero-art { position: relative; animation: fade 1.1s var(--ease) .2s both; }
	.hero-photo { aspect-ratio: 4 / 5; box-shadow: 12px 12px 0 var(--naranja); }
	.trace { position: absolute; left: -38%; bottom: 12%; width: 55%; overflow: visible; z-index: 3; pointer-events: none; }
	.trace path { fill: none; stroke: var(--naranja); stroke-width: 2.5; stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw 1.6s var(--ease) .8s forwards; }
	.trace circle { fill: var(--papel); stroke: var(--naranja); stroke-width: 2.5; opacity: 0; animation: fade .4s 1.8s forwards; }
	@keyframes draw { to { stroke-dashoffset: 0; } }
	.hero-tag { margin: 1.2rem 0 0; font-family: var(--f-mono); font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--gris); }
	@media (max-width: 860px) { .hero-in { grid-template-columns: 1fr; } .hero-art { max-width: 420px; } .trace { display: none; } }

	.areas { background: var(--blanco); border-bottom: 1px solid var(--negro); }
	.areas-in { display: grid; grid-template-columns: repeat(4, 1fr); }
	.area { padding: 2rem 1.6rem 2.2rem 0; border-right: 1px solid var(--linea); }
	.area + .area { padding-left: 1.6rem; }
	.area:last-child { border-right: 0; }
	.area h2 { margin: .6rem 0 .5rem; font-family: var(--f-display); font-stretch: 118%; font-weight: 800; font-size: 1.35rem; text-transform: uppercase; letter-spacing: -.01em; }
	.area p { margin: 0; font-size: .92rem; color: var(--gris); }
	@media (max-width: 860px) { .areas-in { grid-template-columns: 1fr 1fr; } .area:nth-child(2) { border-right: 0; } .area:nth-child(3) { padding-left: 0; } .area:nth-child(n+3) { border-top: 1px solid var(--linea); } }
	@media (max-width: 520px) { .areas-in { grid-template-columns: 1fr; } .area, .area + .area { padding: 1.4rem 0; border-right: 0; border-top: 1px solid var(--linea); } .area:first-child { border-top: 0; } }

	.about, .services, .news { margin-top: clamp(4rem, 9vw, 7rem); }
	.about-in { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem 4rem; }
	.about-big { margin: 0; font-family: var(--f-display); font-stretch: 112%; font-weight: 700; font-size: clamp(1.5rem, 2.8vw, 2.25rem); line-height: 1.15; letter-spacing: -.02em; }
	.about-big em { font-style: normal; color: var(--naranja); }
	@media (max-width: 860px) { .about-in { grid-template-columns: 1fr; } }

	.ct-band { position: relative; margin-top: clamp(4rem, 9vw, 7rem); background: var(--azul); color: var(--blanco); overflow: hidden; }
	.ct-band-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 48px 48px; }
	.ct-band-in { position: relative; display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem 4rem; align-items: end; padding-block: clamp(3.5rem, 8vw, 6rem); }
	.ct-band-t { margin: 0; font-family: var(--f-display); font-stretch: 125%; font-weight: 800; text-transform: uppercase; font-size: clamp(3.5rem, 11vw, 9.5rem); line-height: .82; letter-spacing: -.045em; }
	.ct-band-t span { color: transparent; -webkit-text-stroke: 2px var(--naranja); margin-left: .08em; }
	.ct-band-lema { margin: 0 0 1.5rem; font-size: 1.2rem; color: #d3e2f0; max-width: 32ch; }
	.ct-band-cats { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 2rem; padding: 0; list-style: none; }
	.ct-band-cats li { display: flex; gap: .5rem; align-items: baseline; padding: .4rem .8rem; border: 1px solid rgba(255,255,255,.35); font-weight: 600; }
	.ct-band-hist { margin: 1.8rem 0 0; font-family: var(--f-mono); font-size: .76rem; color: #a9c3dc; }
	.ct-band-hist a { margin-left: .6rem; color: var(--blanco); }
	.ct-band-hist a:hover { color: var(--naranja-vivo); }
	@media (max-width: 860px) { .ct-band-in { grid-template-columns: 1fr; } }

	.svc-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--negro); background: var(--blanco); }
	.svc { position: relative; padding: 1.6rem 1.5rem 3.5rem; text-decoration: none; border-right: 1px solid var(--negro); transition: background .25s var(--ease), color .25s; }
	.svc:last-child { border-right: 0; }
	.svc h3 { margin: .8rem 0 .5rem; font-size: 1.25rem; }
	.svc p { margin: 0; font-size: .92rem; color: var(--gris); transition: color .25s; }
	.svc-arr { position: absolute; left: 1.5rem; bottom: 1.3rem; font-size: 1.2rem; transition: transform .25s var(--ease); }
	.svc:hover { background: var(--azul); color: var(--blanco); }
	.svc:hover p { color: #c3d4e4; }
	.svc:hover .svc-arr { transform: translateX(6px); color: var(--naranja-vivo); }
	@media (max-width: 860px) { .svc-grid { grid-template-columns: 1fr 1fr; } .svc:nth-child(2) { border-right: 0; } .svc:nth-child(n+3) { border-top: 1px solid var(--negro); } }
	@media (max-width: 520px) { .svc-grid { grid-template-columns: 1fr; } .svc { border-right: 0; border-top: 1px solid var(--negro); } .svc:first-child { border-top: 0; } }

	.more { font-family: var(--f-mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; text-decoration: none; white-space: nowrap; }
	.more:hover { color: var(--naranja); }
	.news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem 2rem; }
	.news-card { text-decoration: none; }
	.news-card .frame { aspect-ratio: 3 / 2; --mark: transparent; transition: box-shadow .25s var(--ease), transform .25s var(--ease); }
	.news-card:hover .frame { transform: translate(-3px, -3px); box-shadow: var(--sombra-n); }
	.news-meta { display: flex; gap: 1rem; margin: 1.1rem 0 .4rem; font-family: var(--f-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--gris); }
	.news-meta span { color: var(--naranja); }
	.news-card h3 { margin: 0; font-size: 1.15rem; line-height: 1.3; }
	.news-card:hover h3 { text-decoration: underline; text-decoration-color: var(--naranja); text-underline-offset: .2em; }
	@media (max-width: 860px) { .news-grid { grid-template-columns: 1fr; max-width: 520px; } }

	.join { margin-top: clamp(4rem, 9vw, 7rem); background: var(--naranja); border-top: 1px solid var(--negro); }
	.join-in { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem 4rem; align-items: center; padding-block: clamp(3rem, 7vw, 5rem); }
	.join .display em { color: var(--blanco); }
	.join p { margin: 0 0 1.5rem; font-size: 1.1rem; max-width: 40ch; }
	@media (max-width: 860px) { .join-in { grid-template-columns: 1fr; } }
</style>
