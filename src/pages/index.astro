---
/**
 * Portada. Lo editable (lema, carrusel, áreas, quiénes somos, qué hacemos, únete) está en
 * src/content/inicio/portada.json y se dibuja con renderInicio (igual en la web y en el editor).
 * Lo que se actualiza solo (Cybertech, noticias, curso actual) se rellena aquí, en los huecos `data-keep`.
 */
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { INSTITUCIONES } from '../data/instituciones';
import { getCollection } from 'astro:content';
import { getCursos, getEdiciones, getEntradas, href, img, fecha, BASE } from '../lib/data';
import { normalizeInicio, renderInicio } from '../lib/render';

const [ediciones, cursos, noticias, proyectos, inicio] = await Promise.all([getEdiciones(), getCursos(), getEntradas('noticias'), getEntradas('proyectos'), getCollection('inicio')]);
const ct = ediciones[0];
const curso = cursos[0];
const ultimas = noticias.filter((n) => !n.data.oculto).slice(0, 3);
const datos = normalizeInicio(inicio.find((x) => x.id === 'portada')?.data);

// La parte editable, partida por los huecos que se rellenan aquí: [html, hueco, html, hueco, …, html]
const html = renderInicio(datos, { base: BASE });
const partes = html.split(/<(?:div|span|p) data-keep="([^"]+)"><\/(?:div|span|p)>/);

// Cifras de Reset bajo el lema (si no hay GIF/vídeos ahí). Salen de los datos de la web, así que siempre son ciertas.
const clave = (n: string) => n.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
const personas = new Set(cursos.flatMap((c) => c.data.secciones.flatMap((s) => s.miembros.map((m) => clave(m.nombre))))).size;
// Premios: de la edición más reciente que los tenga (la nueva puede no tenerlos aún)
const conPremio = ediciones.find((e) => e.data.datos.some((d) => /premio/i.test(d.etiqueta)));
const premio = conPremio?.data.datos.find((d) => /premio/i.test(d.etiqueta));
const cifras = [
	{ valor: String(proyectos.filter((x) => !x.data.oculto).length), etiqueta: 'proyectos', url: href('proyectos') },
	{ valor: String(personas), etiqueta: `personas en ${cursos.length} cursos`, url: href('miembros') },
	...(premio ? [{ valor: premio.valor, etiqueta: `${premio.etiqueta} en Cybertech`, url: conPremio!.url }] : []),
];
---

<Layout>
	<div class="inicio">
		<!-- RESET en grande, en la misma fila que las instituciones: al hacer scroll se encoge y vuela hasta el logo de la cabecera -->
		<!-- Zona azul que continúa la barra de arriba. Su borde de abajo sube en un escalón a 45° y lo sigue una pista de
		     circuito que acaba en un punto naranja (como las pistas de una placa). -->
		<div class="inicio-cabeza">
			<div class="inicio-cabeza-fondo" aria-hidden="true"></div>
			<div class="wrap inicio-logo">
				<div class="inicio-logo-in" aria-hidden="true"><Logo tono="blanco" /></div>
				<!-- Instituciones, a la derecha del logo. Se desvanecen al bajar. -->
				<p class="inicio-inst">{INSTITUCIONES.map((i) => <a href={i.url} target="_blank" rel="noopener" title={i.nombre}><img src={href(`marca/${i.logo}-blanco.png`)} alt={i.nombre} onerror="this.parentNode.remove()" /></a>)}</p>
			</div>
			<i class="pista-tramo" aria-hidden="true"></i>
			<svg class="pista-codo" viewBox="0 0 200 72" aria-hidden="true" focusable="false"><path d="M 0 64 H 6.6 L 54.6 16 H 188" /><circle cx="190" cy="16" r="6.5" /></svg>
		</div>
		<!-- Invita a bajar: lleva al carrusel. Desaparece en cuanto se hace scroll. -->
		<button class="baja" type="button" aria-label="Ir a la siguiente sección"><i class="baja-pista"></i><i class="baja-flecha"></i></button>

		<div id="page-root" data-kind="inicio" data-id="portada">
			{partes.map((x, i) => i % 2 === 0 ? <Fragment set:html={x} />
				: x === 'cifras' ? (
					<ul data-keep="cifras" class="hero-cifras">{cifras.map((c) => <li><a href={c.url}><strong>{c.valor}</strong><span>{c.etiqueta}</span></a></li>)}</ul>
				) : x === 'cta-cybertech' ? (
					<span data-keep="cta-cybertech">{ct && <a class="btn primary" href={ct.url}>{ct.label} <span class="arr">→</span></a>}</span>
				) : x === 'curso' ? (
					<p data-keep="curso">{curso && <a href={curso.url}>Conoce al equipo del curso {curso.data.curso} →</a>}</p>
				) : x === 'cybertech' ? (
					<div data-keep="cybertech">
						{ct && (
							<section class="ct-band">
								<div class="ct-band-grid" aria-hidden="true"></div>
								<div class="wrap ct-band-in">
									<div>
										<p class="kicker on-dark"><span>Competición</span><span>Edición {ct.data.anio}</span></p>
										<h2 class="ct-band-t">Cyber<br />tech<span>{String(ct.data.anio).slice(2)}</span></h2>
									</div>
									<div class="ct-band-r">
										<p class="ct-band-lema">{ct.data.lema || 'La competición de robótica más grande de la UPM.'}</p>
										{ct.data.categorias.length > 0 && (
											<ul class="ct-band-cats">{ct.data.categorias.map((c, k) => <li><span class="idx">{String(k + 1).padStart(2, '0')}</span>{c.nombre}</li>)}</ul>
										)}
										{(ct.data.inscripcionDesde || ct.data.inscripcionHasta) && (
											<p class="ct-inscripcion" data-plazo={`${ct.data.inscripcionDesde}|${ct.data.inscripcionHasta}`} hidden>
												{ct.data.inscripcionEnlace && <a class="btn primary" href={ct.data.inscripcionEnlace} target={/^https?:/.test(ct.data.inscripcionEnlace) ? '_blank' : undefined} rel="noopener">Inscríbete <span class="arr">→</span></a>}
												<span>Inscripciones abiertas</span>
											</p>
										)}
										<a class="btn primary" href={ct.url}>Ver las pruebas <span class="arr">→</span></a>
										<p class="ct-band-hist">Ediciones anteriores: {ediciones.slice(1).map((e) => <a href={e.url}>{e.data.anio}</a>)}</p>
									</div>
								</div>
							</section>
						)}
					</div>
				) : x === 'noticias' ? (
					<div data-keep="noticias">
						{ultimas.length > 0 && (
							<section class="wrap news">
								<header class="sec-head reveal"><span class="idx">§03</span><h2>Noticias</h2><span class="rule"></span><a class="more" href={href('noticias')}>Todas →</a></header>
								<div class="news-grid">
									{ultimas.map((n, k) => (
										<a class="news-card reveal" style={`--d:${k}`} href={n.url}>
											<figure class="frame" data-label={n.data.etiquetas[0] ?? 'Reset'}>
												{n.data.portada && <img src={img(n.data.portada)} alt="" loading="lazy" onerror="__img(this)" />}
											</figure>
											<p class="news-meta">{n.data.fecha && <time datetime={n.data.fecha}>{fecha(n.data.fecha)}</time>}{n.data.etiquetas[0] && <span>{n.data.etiquetas[0]}</span>}</p>
											<h3>{n.data.titulo}</h3>
										</a>
									))}
								</div>
							</section>
						)}
					</div>
				) : null)}
		</div>
	</div>
</Layout>

<script>
	/* ───── Carrusel: pasa solo, se para al pasar el ratón; en modo edición enseña la diapositiva que editas ───── */
	const INTERVALO = 6500;
	const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

	function carrusel(car: HTMLElement) {
		if (car.dataset.ok) return;
		car.dataset.ok = '1';
		const slides = [...car.querySelectorAll<HTMLElement>('.car-slide')];
		const dots = [...car.querySelectorAll<HTMLButtonElement>('[data-car-go]')];
		if (slides.length < 2) return;
		// Al volver a dibujarse (modo edición, en cada tecla) sigue en la diapositiva en la que estaba
		const guardada = (window as any).__carIdx;
		let i = typeof guardada === 'number' && guardada < slides.length ? guardada : Math.max(0, slides.findIndex((s) => s.classList.contains('is-on')));
		car.style.setProperty('--car-t', `${INTERVALO}ms`);
		// La barra de cada diapositiva se llena con el tiempo que lleva; las anteriores quedan llenas.
		// Al pausar (ratón encima, fuera de la pantalla) se queda donde estaba y sigue desde ahí.
		let timer = 0, inicio = 0, queda = INTERVALO;
		let encima = false, enPantalla = false;
		const corriendo = () => !reducido && enPantalla && !encima;
		const ir = (n: number) => {
			i = (n + slides.length) % slides.length;
			(window as any).__carIdx = i;
			slides.forEach((s, k) => s.classList.toggle('is-on', k === i));
			dots.forEach((d, k) => {
				d.classList.toggle('hecho', k < i);
				k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current');
			});
			// reinicia la animación de la barra actual
			car.classList.remove('anda'); void car.offsetWidth; car.classList.add('anda');
			queda = INTERVALO;
			reanudar();
		};
		const reanudar = () => {
			clearTimeout(timer);
			const va = corriendo();
			car.classList.toggle('pausado', !va);
			if (!va) return;
			inicio = performance.now();
			timer = window.setTimeout(() => ir(i + 1), queda);
		};
		const parar = () => {
			if (car.classList.contains('pausado')) return;
			clearTimeout(timer);
			queda = Math.max(0, queda - (performance.now() - inicio));
			car.classList.add('pausado');
		};
		const pausa = (p: boolean) => { encima = p; p ? parar() : reanudar(); };
		// Solo cuenta mientras el carrusel se ve
		new IntersectionObserver(([e]) => { enPantalla = e.isIntersecting; enPantalla ? reanudar() : parar(); }, { threshold: 0.4 }).observe(car);
		car.querySelector('[data-car-prev]')?.addEventListener('click', () => ir(i - 1));
		car.querySelector('[data-car-next]')?.addEventListener('click', () => ir(i + 1));
		dots.forEach((d) => d.addEventListener('click', () => ir(Number(d.dataset.carGo))));
		car.addEventListener('pointerenter', () => pausa(true));
		car.addEventListener('pointerleave', () => pausa(false));
		car.addEventListener('focusin', () => pausa(true));
		car.addEventListener('focusout', () => pausa(false));
		// Deslizar con el dedo
		let x0 = 0;
		car.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
		car.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) ir(i + (dx < 0 ? 1 : -1)); });
		(car as any).__ir = (n: number) => { encima = true; ir(n); parar(); };
		ir(i);
	}
	const iniciar = () => document.querySelectorAll<HTMLElement>('[data-car]').forEach(carrusel);
	iniciar();
	document.addEventListener('reset:rendered', iniciar);
	document.addEventListener('reset:editando', (e) => {
		const m = String((e as CustomEvent).detail ?? '').match(/^diapositivas\.(\d+)/);
		const car = document.querySelector<HTMLElement>('[data-car]') as any;
		if (m && car?.__ir) car.__ir(Number(m[1]));
	});

	/* ───── Las secciones aparecen al entrar en pantalla (de desenfocadas a nítidas) y, si se vuelve a subir y quedan
	   por debajo, se desdibujan otra vez (arriba del todo, el carrusel vuelve a ser solo un anticipo) ───── */
	const SECCIONES_INICIO = ['[data-car]', '.inicio .areas', '.inicio .about', '.inicio [data-keep="cybertech"] > section', '.inicio .services', '.inicio [data-keep="noticias"] > section', '.inicio .join'];
	if (!document.documentElement.classList.contains('is-admin') && !reducido) {
		const ver = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (e.isIntersecting) e.target.classList.add('visto');
				// Solo se esconde si ha salido por abajo (al subir); si sale por arriba (al bajar) se queda nítida
				else if (e.boundingClientRect.top > 0) e.target.classList.remove('visto');
			}
		}, { rootMargin: '0px 0px -30% 0px' }); // al pasar su borde superior del 70% de la pantalla (arriba del todo, el carrusel aún no)
		document.querySelectorAll<HTMLElement>(SECCIONES_INICIO.join(',')).forEach((el) => { el.classList.add('aparece'); ver.observe(el); });
	}

	/* ───── Botón para bajar: se esconde al hacer scroll y vuelve tras un rato quieto, si queda algo debajo ───── */
	const baja = document.querySelector<HTMLButtonElement>('.baja');
	let quieto = 0;
	const quedaDebajo = () => innerHeight + scrollY < document.documentElement.scrollHeight - 160;
	const esconder = () => {
		baja?.classList.add('fuera');
		clearTimeout(quieto);
		quieto = window.setTimeout(() => baja?.classList.toggle('fuera', !quedaDebajo()), 2600);
	};
	addEventListener('scroll', esconder, { passive: true });
	baja?.classList.toggle('fuera', !quedaDebajo());
	// Lleva al principio de la siguiente sección, justo debajo de la cabecera (nunca a medias de una)
	baja?.addEventListener('click', () => {
		const cabecera = document.querySelector<HTMLElement>('.nav')?.offsetHeight ?? 72;
		const destinos = [...document.querySelectorAll<HTMLElement>('[data-car] .car-track, .inicio .areas, .inicio .about, .inicio [data-keep="cybertech"] > section, .inicio .services, .inicio [data-keep="noticias"] > section, .inicio .join')]
			// offsetTop no cuenta el desplazamiento de la animación de entrada (getBoundingClientRect sí)
			.map((el) => { let y = 0; for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop; return y - cabecera - 20; })
			.sort((a, b) => a - b);
		const y = destinos.find((d) => d > scrollY + 10);
		if (y !== undefined) scrollTo({ top: y, behavior: reducido ? 'auto' : 'smooth' });
	});


	/* ───── Primera pantalla: el carrusel empieza justo debajo del borde de la pantalla (que no asome un trozo) ───── */
	const carrusel0 = document.querySelector<HTMLElement>('[data-car]');
	if (carrusel0 && !document.documentElement.classList.contains('is-admin')) {
		const hueco = () => {
			carrusel0.style.marginTop = '';
			// offsetTop: sin contar el desplazamiento de la animación de entrada
			let y = 0; for (let n: HTMLElement | null = carrusel0; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
			const falta = innerHeight - y + 24;
			if (falta > 0) carrusel0.style.marginTop = `${falta}px`;
		};
		hueco();
		addEventListener('resize', hueco);
		document.fonts?.ready.then(hueco);
		addEventListener('load', hueco);
	}

	/* ───── Logos de las instituciones a la altura de las letras de RESET (en el logo, del 35,7 % al 83,1 % de su alto) ───── */
	const instFila = document.querySelector<HTMLElement>('.inicio-inst');
	const logoImg = document.querySelector<HTMLImageElement>('.inicio-logo .logo img');
	const logoCaja = document.querySelector<HTMLElement>('.inicio-logo-in');
	if (instFila && logoImg && logoCaja) {
		let altoPuesto = 0;
		const alinear = () => {
			// Las instituciones, del alto que tenían las letras antes de agrandar el logo un 10 %, y centradas en las letras de ahora
			// (con valores redondeados a medio píxel y sin tocar nada si no cambia: las instituciones y el hueco del logo se
			// miden el uno al otro, y con decimales sueltos se quedaban rebotando 1 px en cada fotograma: la pantalla temblaba)
			const proporcion = logoImg.naturalWidth ? logoImg.naturalHeight / logoImg.naturalWidth : 0.2587;
			let alto = logoCaja.offsetWidth * proporcion; // sin el 10 % de más ni la transformación del vuelo
			if (!alto) return;
			if (Math.abs(alto - altoPuesto) < 2) alto = altoPuesto; // cambios de 1 px: los provoca este mismo ajuste
			altoPuesto = alto;
			const centroLetras = logoImg.offsetTop - logoCaja.offsetTop + alto * 1.1 * 0.594;
			const top = `${Math.round(centroLetras - alto * 0.237)}px`, h = `${Math.round(alto * 0.474)}px`;
			if (instFila.style.getPropertyValue('--wm-top') !== top) instFila.style.setProperty('--wm-top', top);
			if (instFila.style.getPropertyValue('--wm-h') !== h) instFila.style.setProperty('--wm-h', h);
			// El escalón del borde azul, centrado en el hueco entre RESET y las instituciones (si se ven: en el móvil no)
			const cabeza = instFila.closest<HTMLElement>('.inicio-cabeza');
			const fila = instFila.parentElement!;
			if (cabeza && instFila.offsetParent) {
				const finLogo = fila.offsetLeft + logoCaja.offsetLeft + logoCaja.offsetWidth;
				const inicioInst = fila.offsetLeft + instFila.offsetLeft;
				cabeza.style.setProperty('--paso', `${Math.round((finLogo + inicioInst) / 2 - 24)}px`);
			} else cabeza?.style.removeProperty('--paso');
		};
		if (logoImg.complete) alinear(); else logoImg.addEventListener('load', alinear, { once: true });
		addEventListener('resize', alinear);
		new ResizeObserver(alinear).observe(logoCaja);
	}

	/* ───── Logos de las instituciones: se desvanecen en cuanto se empieza a bajar ───── */
	const inst = document.querySelector<HTMLElement>('.inicio-inst');
	if (inst) {
		let pend = 0;
		const fundir = () => {
			pend = 0;
			inst.style.setProperty('--inst-p', String(Math.min(1, scrollY / 140)));
			inst.classList.toggle('saliendo', scrollY > 0);
			inst.style.visibility = scrollY > 140 ? 'hidden' : '';
		};
		addEventListener('scroll', () => { pend ||= requestAnimationFrame(fundir); }, { passive: true });
		fundir();
	}

	/* ───── RESET en grande que vuela hasta la cabecera al hacer scroll ───── */
	const grande = document.querySelector<HTMLImageElement>('.inicio-logo .logo img');
	const peque = document.querySelector<HTMLImageElement>('.nav-logo img');
	const raiz = document.documentElement;
	if (grande && peque && !reducido) {
		raiz.classList.add('logo-volando');
		let origen: DOMRect, origenY = 0;
		const medir = () => {
			grande.style.transform = '';
			origen = grande.getBoundingClientRect();
			origenY = origen.top + scrollY; // posición en la página, sin scroll
		};
		const suave = (t: number) => t * t * (3 - 2 * t); // empieza y termina despacio
		// En vertical el logo va pegado a la página: sube exactamente lo que sube la ventana, como cualquier otro
		// contenido. Mientras sube, se encoge y se desplaza en horizontal hacia el logo de la cabecera, y llega justo
		// cuando su borde de arriba alcanza el de la cabecera; desde ahí se queda fijo en ella.
		const pintar = () => {
			const destino = peque.getBoundingClientRect();
			const arriba = origenY - scrollY;                    // dónde está su borde de arriba sin moverlo (sube con la página)
			const recorrido = Math.max(1, origenY - destino.top); // cuánto tiene que subir hasta la cabecera
			const p = Math.min(1, Math.max(0, scrollY / recorrido));
			const e = suave(p);
			const escala = 1 + (destino.width / origen.width - 1) * e;
			const x = (destino.left - origen.left) * e;
			const y = Math.max(0, destino.top - arriba);          // 0 mientras sube con la página; luego, lo justo para quedarse en la cabecera
			grande.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${escala})`;
			raiz.classList.toggle('logo-llegado', p >= 1);
		};
		let pendiente = 0;
		const pedir = () => { pendiente ||= requestAnimationFrame(() => { pendiente = 0; pintar(); }); };
		const preparar = () => { medir(); pintar(); };
		if (grande.complete) preparar(); else grande.addEventListener('load', preparar, { once: true });
		addEventListener('scroll', pedir, { passive: true });
		addEventListener('resize', preparar);
	}
</script>

<style is:global>
	/* ───── RESET grande ───── */
	/* ───── Zona azul de arriba con borde de circuito ───── */
	/* --paso: dónde sube el borde (entre el logo y las instituciones). Sube 48 px en 45° (48 px en horizontal también) */
	.inicio-cabeza { --paso: 58%; position: relative; color: #fff; padding-bottom: calc(48px + 18px + clamp(.5rem, 1.2vw, .9rem)); margin-bottom: 24px; }
	/* (empieza 2 px más arriba para tapar la juntura con la barra) */
	.inicio-cabeza-fondo { position: absolute; inset: -2px 0 0; background: var(--azul);
		clip-path: polygon(0 0, 100% 0, 100% calc(100% - 48px), calc(var(--paso) + 48px) calc(100% - 48px), var(--paso) 100%, 0 100%); }
	/* La pista: paralela al borde, 16 px por debajo, y acaba en un punto naranja.
	   Tramo recto (hasta el codo) + el codo de 45° y el final con el punto (SVG con origen en el codo, 48 px por encima del borde) */
	.pista-tramo { position: absolute; left: 0; top: calc(100% + 15px); width: calc(var(--paso) + 7px); height: 2px; background: var(--azul); pointer-events: none; }
	.pista-codo { position: absolute; left: var(--paso); top: calc(100% - 48px); width: 200px; height: 72px; overflow: visible; pointer-events: none; }
	.pista-codo path { stroke: var(--azul); stroke-width: 2; fill: none; }
	.pista-codo circle { fill: var(--naranja); stroke: var(--papel); stroke-width: 3; }
	@media (max-width: 700px) { .inicio-cabeza { --paso: calc(100% - 250px); } }
	.inicio-cabeza { overflow-x: clip; overflow-y: visible; }

	/* Una fila: RESET ocupa todo lo que dejan libre los logos de las instituciones, a su derecha */
	.inicio-logo { padding-top: clamp(.4rem, 1vw, .75rem); position: relative; container-type: inline-size; display: flex; align-items: flex-start; justify-content: space-between; gap: clamp(96px, 9cqi, 130px); } /* el hueco siempre cabe el escalón (48 px) con margen */
	/* RESET hasta 720 px de ancho; las instituciones, a la derecha. En escritorio el logo baja 36 px hacia la parte
	   honda del azul (bajo él el borde está 48 px más abajo que bajo las instituciones), así no crece la cabecera */
	.inicio-logo-in { flex: 0 1 720px; min-width: 0; }
	@media (min-width: 701px) { .inicio-logo-in { margin-bottom: -36px; } }
