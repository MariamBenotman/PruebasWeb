---
import Layout from '../layouts/Layout.astro';
import { paginas } from '../data/paginas';
import { getCursos, getEdiciones, getNoticias, href } from '../lib/data';

const [noticias, cursos, ediciones] = await Promise.all([getNoticias(), getCursos(), getEdiciones()]);
const index = [
	...ediciones.map((e) => ({ t: e.label, s: 'Cybertech', d: [e.data.lema, e.data.categorias.map((c) => c.nombre).join(' ')].join(' '), u: e.url })),
	...cursos.map((c) => ({ t: c.label, s: 'Miembros', d: c.data.secciones.flatMap((s) => s.miembros.map((m) => `${m.nombre} ${m.roles.join(' ')}`)).join(' · '), u: c.url })),
	...noticias.map((n) => ({ t: n.data.title, s: 'Noticias', d: n.data.summary, u: href(`noticias/${n.id}`) })),
	...paginas.map((p) => ({ t: p.titulo, s: p.seccion, d: p.intro, u: href(p.slug) })),
];
---

<Layout title="Buscar">
	<div class="wrap sr">
		<header class="pg-head">
			<p class="kicker"><span>Reset</span><span>Buscar</span></p>
			<h1 class="display">Bus<em>car</em></h1>
		</header>
		<input class="sr-in" type="search" placeholder="Cybertech, sumo, impresión 3D, un nombre…" aria-label="Buscar" autofocus />
		<p class="sr-n" aria-live="polite"></p>
		<ol class="sr-list"></ol>
	</div>
</Layout>

<script define:vars={{ index }}>
	const input = document.querySelector('.sr-in');
	const list = document.querySelector('.sr-list');
	const count = document.querySelector('.sr-n');
	const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
	const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
	const run = () => {
		const q = norm(input.value.trim());
		const terms = q.split(/\s+/).filter(Boolean);
		const hits = terms.length ? index.filter((x) => terms.every((t) => norm(`${x.t} ${x.s} ${x.d}`).includes(t))) : [];
		count.textContent = terms.length ? `${hits.length} ${hits.length === 1 ? 'resultado' : 'resultados'}` : '';
		list.innerHTML = hits.map((x) => `<li><a href="${x.u}"><span class="idx">${esc(x.s)}</span><h2>${esc(x.t)}</h2><p>${esc(x.d.slice(0, 180))}</p></a></li>`).join('');
		history.replaceState(null, '', input.value ? `?q=${encodeURIComponent(input.value)}` : location.pathname);
	};
	input.value = new URLSearchParams(location.search).get('q') || '';
	input.addEventListener('input', run);
	run();
</script>

<style>
	.sr { padding-bottom: 6rem; min-height: 60vh; }
	.sr-in { width: 100%; padding: 1rem 1.2rem; border: 1.5px solid var(--negro); background: var(--blanco); font-size: 1.2rem; box-shadow: var(--sombra); }
	.sr-in:focus { outline: none; box-shadow: var(--sombra-n); }
	.sr-n { margin: 1.5rem 0 .5rem; font-family: var(--f-mono); font-size: .78rem; text-transform: uppercase; color: var(--gris); }
	.sr-list { margin: 0; padding: 0; list-style: none; }
	.sr-list :global(a) { display: block; padding: 1.2rem 0; border-bottom: 1px solid var(--linea); text-decoration: none; }
	.sr-list :global(h2) { margin: .2rem 0; font-size: 1.25rem; }
	.sr-list :global(p) { margin: 0; color: var(--gris); font-size: .92rem; }
	.sr-list :global(a:hover h2) { color: var(--naranja); }
</style>
