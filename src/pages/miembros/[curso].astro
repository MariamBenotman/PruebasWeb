---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { getCursos, BASE, href } from '../../lib/data';
import { renderCurso, cursoCorto, indiceFotos } from '../../lib/render';

export async function getStaticPaths() {
	const cursos = await getCursos();
	return cursos.map((c) => ({ params: { curso: c.id }, props: { id: c.id } }));
}

const cursos = await getCursos();
const actual = cursos.find((c) => c.id === Astro.props.id)!;
// Quien no tiene foto este curso sale con la de otro curso suyo (la más cercana en el tiempo)
// (solo las fotos cuyo archivo existe, para no probar rutas vacías)
const fotosDe = indiceFotos(cursos.map((c) => c.data), actual.data.curso);
const hoverDe = indiceFotos(cursos.map((c) => c.data), actual.data.curso, 'fotoHover');
const existe = (p: string) => /^(https?:|\/)/.test(p) || fs.existsSync(path.join(process.cwd(), 'public', p));
const html = renderCurso(actual.data, { base: BASE, fotosDe: (n) => fotosDe(n).filter(existe), hoverDe: (n) => hoverDe(n).filter(existe) });
---

<Layout title={`Miembros ${cursoCorto(actual.data.curso)}`} description={`Equipo de la Asociación de Estudiantes Reset durante el curso ${actual.data.curso}.`}>
	<nav class="yearbar" aria-label="Cursos">
		<div class="wrap">
			<a class="lbl" href={href('miembros')} title="Ver todos los cursos">Cursos</a>
			{cursos.map((c) => <a href={c.url} aria-current={c.id === actual.id ? 'page' : undefined}>{cursoCorto(c.data.curso)}</a>)}
		</div>
	</nav>
	<div id="page-root" data-kind="miembros" data-id={actual.id} set:html={html} />
</Layout>
