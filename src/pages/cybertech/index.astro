---
/** Todas las ediciones de Cybertech (el menú solo enseña las últimas). */
import Layout from '../../layouts/Layout.astro';
import { getEdiciones, href, img } from '../../lib/data';
const ediciones = await getEdiciones();
---

<Layout title="Cybertech · Todas las ediciones" description="Todas las ediciones de Cybertech, la competición de robótica de la UPM organizada por Reset.">
	<section class="cti">
		<div class="wrap">
			<header class="pg-head">
				<p class="kicker on-dark"><span>Competición de robótica</span><span>{String(ediciones.length).padStart(2, '0')} ediciones</span></p>
				<h1 class="display">Cybertech</h1>
				<div class="cti-row">
					<p class="lede">La mayor competición de robótica de la UPM, organizada por Reset en la ETSII. Estas son todas las ediciones.</p>
					<a class="btn primary adm-only" href={href('editar?tipo=cybertech')}>+ Nueva edición</a>
				</div>
			</header>
			<ol class="cti-grid">
				{ediciones.map((e, i) => (
					<li class="reveal" style={`--d:${i % 6}`}>
						<a href={e.url}>
							<figure class="frame on-dark" data-label={e.label}>
								{e.data.portada && <img src={img(e.data.portada)} alt="" loading="lazy" onerror="__img(this)" />}
							</figure>
							<div class="cti-txt">
								<strong>{e.data.anio}</strong>
								{e.data.lema && <p>{e.data.lema}</p>}
								{e.data.fechas && <span>{e.data.fechas}</span>}
							</div>
						</a>
					</li>
				))}
			</ol>
		</div>
	</section>
</Layout>

<style>
	.cti { background: var(--azul-hondo); color: #dce8f3; padding-bottom: 6rem; }
	.cti .display { color: var(--blanco); }
	.cti .lede { color: #b9cde0; margin: 0; max-width: 56ch; }
	.cti-row { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 3rem; margin-top: 1.8rem; }
	.cti-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.6rem; margin: 0; padding: 0; list-style: none; }
	.cti-grid a { display: flex; flex-direction: column; height: 100%; text-decoration: none; border: 1px solid #2b5a85; background: var(--azul); transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s; }
	.cti-grid a:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--naranja); border-color: var(--naranja); }
	.cti-grid .frame { --mark: transparent; aspect-ratio: var(--a3); margin: 0; border-bottom: 1px solid #2b5a85; }
	.cti-grid .frame img { width: 100%; height: 100%; object-fit: cover; }
	.cti-txt { display: grid; gap: .35rem; padding: 1.1rem 1.3rem 1.4rem; }
	.cti-txt strong { font-family: var(--f-display); font-stretch: 125%; font-weight: 900; font-size: 2.2rem; line-height: 1; color: var(--naranja-vivo); }
	.cti-txt p { margin: 0; color: #dce8f3; }
	.cti-txt span { font-family: var(--f-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: #9db7d0; }
</style>
