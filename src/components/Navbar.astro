---
import Logo from './Logo.astro';
import { getCursos, getEdiciones, href } from '../lib/data';
import { menuFijo, paginaPorSlug, contacto } from '../data/paginas';

const [cursos, ediciones] = await Promise.all([getCursos(), getEdiciones()]);
const path = Astro.url.pathname;
const isActive = (slug: string) => path.startsWith(href(slug));

interface Hijo { titulo: string; url: string; sep?: boolean }
interface Entrada { titulo: string; url: string; activo: string; hijos: Hijo[]; admin?: Hijo }

const menu: Entrada[] = [
	{
		titulo: 'Cybertech', url: ediciones[0]?.url ?? href(), activo: 'cybertech',
		hijos: ediciones.map((e) => ({ titulo: e.label, url: e.url })),
		admin: { titulo: 'Nueva edición', url: href('editar?tipo=cybertech') },
	},
	...menuFijo.map((m) => ({
		titulo: m.titulo, url: href(m.slug), activo: m.slug,
		hijos: m.hijos.map((s) => ({ titulo: paginaPorSlug(s)?.titulo ?? s, url: href(s) })),
	})),
	{ titulo: 'Noticias', url: href('noticias'), activo: 'noticias', hijos: [] },
	{
		titulo: 'Conócenos', url: cursos[0]?.url ?? href('contacto'), activo: 'miembros',
		hijos: [
			...cursos.map((c) => ({ titulo: c.label, url: c.url })),
			{ titulo: 'Colaboradores', url: href('colaboradores'), sep: true },
			{ titulo: 'Contacto', url: href('contacto') },
		],
		admin: { titulo: 'Nuevo curso', url: href('editar?tipo=miembros') },
	},
];
---

<div class="strip">
	<div class="wrap">
		<span>Asociación de estudiantes · ETSII-UPM</span>
		<span class="strip-r">
			{contacto.redes.map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}
		</span>
	</div>
</div>
<header class="nav" id="top">
	<div class="wrap nav-in">
		<a class="nav-logo" href={href()} aria-label="Reset, inicio"><Logo /></a>
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu"><span></span><span></span><span class="sr-only">Menú</span></button>
		<nav id="menu" class="nav-menu" aria-label="Principal">
			<ul>
				{menu.map((m) => (
					<li class:list={['nav-item', { 'has-sub': m.hijos.length || m.admin }]}>
						<a href={m.url} aria-current={isActive(m.activo) ? 'page' : undefined}>{m.titulo}</a>
						{(m.hijos.length > 0 || m.admin) && (
							<div class="sub">
								<ul>
									{m.hijos.map((h) => <li class:list={{ sep: h.sep }}><a href={h.url}>{h.titulo}</a></li>)}
									{m.admin && <li class="adm-only sub-add"><a href={m.admin.url}>+ {m.admin.titulo}</a></li>}
								</ul>
							</div>
						)}
					</li>
				))}
			</ul>
			<a class="btn primary nav-cta" href={href('participa')}>Únete <span class="arr">→</span></a>
		</nav>
	</div>
</header>

<script>
	const t = document.querySelector<HTMLButtonElement>('.nav-toggle');
	t?.addEventListener('click', () => {
		const open = t.getAttribute('aria-expanded') !== 'true';
		t.setAttribute('aria-expanded', String(open));
		document.querySelector('.nav')?.classList.toggle('is-open', open);
	});
</script>

<style>
	.strip { background: var(--azul); color: #b9cde0; font-family: var(--f-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .09em; }
	.strip .wrap { display: flex; justify-content: space-between; gap: 1rem; padding-block: .45rem; }
	.strip-r { display: flex; gap: 1.2rem; }
	.strip a { text-decoration: none; }
	.strip a:hover { color: var(--naranja-vivo); }
	@media (max-width: 640px) { .strip-r { display: none; } }

	.nav { position: sticky; top: 0; z-index: 50; background: var(--papel); border-bottom: 1px solid var(--negro); }
	.nav-in { display: flex; align-items: center; gap: 2rem; height: 72px; }
	.nav-logo { height: 38px; display: flex; text-decoration: none; margin-right: auto; }
	.nav-menu { display: flex; align-items: center; gap: 1.6rem; height: 100%; }
	.nav-menu > ul { display: flex; height: 100%; margin: 0; padding: 0; list-style: none; }
	.nav-item { position: relative; display: flex; align-items: center; }
	.nav-item > a {
		display: flex; align-items: center; height: 100%; padding: 0 .85rem; text-decoration: none;
		font-weight: 600; font-size: .92rem; letter-spacing: -.005em; position: relative;
	}
	.nav-item > a::after { content: ''; position: absolute; left: .85rem; right: .85rem; bottom: -1px; height: 3px; background: var(--naranja); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
	.nav-item:hover > a::after, .nav-item > a[aria-current]::after { transform: scaleX(1); }
	.has-sub > a { padding-right: 1.5rem; }
	.has-sub > a::before { content: ''; position: absolute; right: .7rem; top: 50%; width: 5px; height: 5px; border-right: 1.5px solid; border-bottom: 1.5px solid; transform: translateY(-70%) rotate(45deg); opacity: .6; }
	.sub {
		position: absolute; top: 100%; left: 0; min-width: 230px; padding-top: 1px;
		opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .2s, transform .25s var(--ease), visibility 0s .25s;
	}
	.sub ul { margin: 0; padding: .4rem; list-style: none; background: var(--blanco); border: 1px solid var(--negro); box-shadow: var(--sombra); }
	.nav-item:hover .sub, .nav-item:focus-within .sub { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
	.sub a { display: block; padding: .5rem .7rem; text-decoration: none; font-size: .9rem; }
	.sub a:hover { background: var(--papel-2); }
	.sub .sep { margin-top: .3rem; padding-top: .3rem; border-top: 1px solid var(--linea); }
	.sub-add a { font-family: var(--f-mono); font-size: .78rem; color: var(--naranja); text-transform: uppercase; letter-spacing: .05em; border: 1px dashed var(--naranja); margin-top: .35rem; }
	.nav-cta { padding: .6rem 1rem; box-shadow: 3px 3px 0 var(--negro); }
	.nav-toggle { display: none; }

	@media (max-width: 1080px) {
		.nav-toggle { display: grid; gap: 6px; width: 44px; height: 44px; place-content: center; border: 1px solid var(--negro); background: none; cursor: pointer; }
		.nav-toggle span:not(.sr-only) { width: 20px; height: 1.5px; background: var(--negro); transition: transform .25s var(--ease); }
		.nav.is-open .nav-toggle span:nth-child(1) { transform: translateY(3.75px) rotate(45deg); }
		.nav.is-open .nav-toggle span:nth-child(2) { transform: translateY(-3.75px) rotate(-45deg); }
		.nav-menu { display: none; position: absolute; top: 100%; left: 0; right: 0; height: auto; max-height: calc(100vh - 72px); overflow-y: auto; flex-direction: column; align-items: stretch; padding: 1rem var(--gutter) 2rem; background: var(--papel); border-bottom: 1px solid var(--negro); }
		.nav.is-open .nav-menu { display: flex; }
		.nav-menu > ul { flex-direction: column; height: auto; }
		.nav-item { flex-direction: column; align-items: stretch; border-bottom: 1px solid var(--linea); }
		.nav-item > a { height: auto; padding: .9rem 0; font-size: 1.15rem; }
		.nav-item > a::after, .has-sub > a::before { display: none; }
		.sub { position: static; opacity: 1; visibility: visible; transform: none; padding: 0 0 .8rem; }
		.sub ul { border: 0; box-shadow: none; background: none; padding: 0; columns: 2; }
		.sub a { padding: .35rem 0; color: var(--gris); }
		.nav-cta { align-self: flex-start; margin-top: 1rem; }
	}
</style>
