---
import Logo from './Logo.astro';
import { getCursos, getEdiciones, getArbol, getPaginas, href, img, fecha } from '../lib/data';
import { contacto } from '../data/contacto';
import { SECCIONES, type SeccionKey } from '../lib/render';
import sitio from '../data/sitio.json';

/**
 * Límites de los desplegables (se cambian en src/data/sitio.json → "menu"):
 *  - maxPorDesplegable: como mucho, cuántas cosas enseña cada desplegable (y cada panel lateral).
 *    Si hay más, se añade "Ver todo" al final.
 *  - noticiasConFoto: cuántas noticias, con su imagen, enseña el desplegable de Noticias.
 */
const MAX = sitio.menu?.maxPorDesplegable ?? 6;
const MAX_NOTICIAS = sitio.menu?.noticiasConFoto ?? 3;

interface Ficha { titulo: string; url: string; fecha: string; portada: string }
interface Hijo {
	titulo: string; url: string; sep?: boolean;
	/** Texto corto en gris debajo del título ("C, Python, Linux…") */
	desc?: string;
	/** Panel lateral con las ediciones anteriores (y, en modo edición, "+ Nueva edición") */
	fly?: { hijos: Hijo[]; nueva: string };
	/** Casilla «Destacar en el menú»: estrella y franja naranja, y sale el primero */
	resaltado?: boolean;
}
interface Entrada { titulo: string; url: string; activo: string; hijos: Hijo[]; noticias?: Ficha[]; admin: Hijo[] }

/** Los primeros `max` y, si hay más, un enlace "Ver todo (N)" */
const limitar = (items: Hijo[], max: number, titulo: string, url: string): Hijo[] =>
	items.length > max ? [...items.slice(0, max), { titulo: `${titulo} (${items.length})`, url, sep: true }] : items;

const secciones = Object.keys(SECCIONES) as SeccionKey[];
const arboles = Object.fromEntries(await Promise.all(secciones.map(async (s) => [s, await getArbol(s)] as const)));
const [cursos, ediciones, paginas] = await Promise.all([getCursos(), getEdiciones(), getPaginas()]);

const seccionMenu = (s: SeccionKey): Entrada => {
	const { raiz } = arboles[s];
	const conEdiciones = SECCIONES[s].ediciones;
	const nueva = (id: string) => href(`editar?tipo=${s}&serie=${id}`);
	// Todo al mismo nivel. Lo que se repite (Octubre Robótico) enlaza a su última edición y, al pasar
	// el ratón, enseña las anteriores. Lo oculto y lo que solo va dentro de otra página no sale.
	const items: Hijo[] = raiz.filter((r) => r.listada).map((r) => {
		const [ultima, ...anteriores] = r.visibles;
		return {
			titulo: ultima?.data.titulo ?? r.data.titulo,
			url: ultima?.url ?? r.url,
			desc: ultima?.data.descMenu || r.data.descMenu,
			resaltado: r.data.destacado || !!ultima?.data.destacado,
			fly: conEdiciones ? {
				nueva: nueva(r.id),
				hijos: anteriores.length
					? [...limitar(anteriores.map((e) => ({ titulo: e.data.titulo, url: e.url })), MAX, 'Todas las ediciones', r.url),
						...(anteriores.length > MAX ? [] : [{ titulo: `Sobre ${r.data.titulo} →`, url: r.url, sep: true }])]
					: [],
			} : undefined,
		};
	});
	// Lo marcado como «Destacar en el menú» va primero
	items.sort((a, b) => Number(!!b.resaltado) - Number(!!a.resaltado));
	return {
		titulo: SECCIONES[s].titulo, url: href(s), activo: s,
		hijos: limitar(items, MAX, 'Ver todos', href(s)),
		admin: [{ titulo: SECCIONES[s].nuevo, url: href(`editar?tipo=${s}`) }],
	};
};

const noticias = arboles.noticias.todas.filter((n) => !n.data.oculto);
const path = Astro.url.pathname;
const isActive = (slug: string) => path.startsWith(href(slug));

const menu: Entrada[] = [
	{
		titulo: 'Cybertech', url: ediciones[0]?.url ?? href(), activo: 'cybertech',
		hijos: limitar(ediciones.map((e) => ({ titulo: e.label, url: e.url })), MAX, 'Todas las ediciones', href('cybertech')),
		admin: [{ titulo: 'Nueva edición', url: href('editar?tipo=cybertech') }],
	},
	seccionMenu('proyectos'),
	seccionMenu('talleres'),
	seccionMenu('servicios'),
	{
		// Noticias: las últimas, con su imagen
		titulo: SECCIONES.noticias.titulo, url: href('noticias'), activo: 'noticias',
		noticias: noticias.slice(0, MAX_NOTICIAS).map((n) => ({ titulo: n.data.titulo, url: n.url, fecha: n.data.fecha, portada: img(n.data.portada) })),
		hijos: noticias.length > MAX_NOTICIAS ? [{ titulo: `Ver todas las noticias (${noticias.length})`, url: href('noticias'), sep: true }] : [],
		admin: [{ titulo: SECCIONES.noticias.nuevo, url: href('editar?tipo=noticias') }],
	},
	{
		titulo: 'Conócenos', url: cursos[0]?.url ?? href(), activo: 'miembros',
		hijos: [
			...limitar(cursos.map((c) => ({ titulo: c.label, url: c.url })), MAX, 'Todos los cursos', href('miembros')),
			// Apartados editables (Colaboradores, Contacto…), debajo de la línea
			...paginas.filter((p) => p.data.menu).map((p, i) => ({ titulo: p.data.titulo, url: p.url, sep: i === 0 })),
		],
		admin: [
			{ titulo: 'Nuevo curso', url: href('editar?tipo=miembros') },
			{ titulo: 'Nuevo apartado', url: href('editar?tipo=paginas') },
		],
	},
];

/** Para el modo edición: qué entradas genéricas hay en cada sección (desplegable "Es una edición de…"). */
const series = Object.fromEntries(secciones.map((s) => [s, arboles[s].raiz.map((r) => ({
	id: r.id, titulo: r.data.titulo, ediciones: r.ediciones.map((e) => e.id),
	resumen: r.data.resumen, portada: r.data.portada, oculto: r.data.oculto,
}))]));
const seriesJson = JSON.stringify(series).replace(/</g, '\\u003c');
const tieneSub = (m: Entrada) => m.hijos.length > 0 || !!m.noticias?.length;
---

<div class="strip">
	<div class="wrap">
		<span>Asociación de estudiantes · ETSII-UPM</span>
		<span class="strip-r">
			{contacto.redes.map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}
		</span>
	</div>
</div>
<header class="nav" id="top">
	<div class="wrap nav-in">
		<a class="nav-logo" href={href()} aria-label="Reset, inicio"><Logo /></a>
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span><span class="sr-only">Menú</span></button>
		<nav id="menu" class="nav-menu" aria-label="Principal">
			<ul>
				{menu.map((m) => (
					<li class:list={['nav-item', { 'has-sub': tieneSub(m), 'adm-sub': !tieneSub(m) && m.admin.length }]}>
						<a href={m.url} aria-current={isActive(m.activo) ? 'page' : undefined}>{m.titulo}</a>
						{(tieneSub(m) || m.admin.length > 0) && (
							<div class:list={['sub', { 'adm-only': !tieneSub(m), 'sub-news': m.noticias }]}>
								<ul>
									{m.noticias?.map((n) => (
										<li class="news-i">
											<a href={n.url}>
												<span class="news-img">{n.portada && <img data-src={n.portada} alt="" onerror="this.remove()" />}</span>
												<span class="news-txt">
													{n.fecha && <time datetime={n.fecha}>{fecha(n.fecha)}</time>}
													<span class="news-t">{n.titulo}</span>
												</span>
											</a>
										</li>
									))}
									{m.hijos.map((h) => (
										<li class:list={{ sep: h.sep, 'has-fly': h.fly, 'fly-vacio': h.fly && !h.fly.hijos.length, resaltado: h.resaltado }}>
											<a href={h.url}>
												{h.resaltado && <i class="estrella" aria-hidden="true">★</i>}
												<span class="t">{h.titulo}{h.desc && <small class="desc">{h.desc}</small>}</span>
											</a>
											{h.fly && (
												<div class="fly">
													<ul>
														{h.fly.hijos.map((f) => <li class:list={{ sep: f.sep }}><a href={f.url}>{f.titulo}</a></li>)}
														<li class="adm-only sub-add"><a href={h.fly.nueva}>+ Nueva edición</a></li>
													</ul>
												</div>
											)}
										</li>
									))}
									{m.admin.map((a) => <li class="adm-only sub-add"><a href={a.url}>+ {a.titulo}</a></li>)}
								</ul>
							</div>
						)}
					</li>
				))}
			</ul>
			<a class="btn primary nav-cta" href={href('participa')}>Únete <span class="arr">→</span></a>
		</nav>
	</div>
</header>

<script type="application/json" id="series-data" is:inline set:html={seriesJson} />

<script>
	// Fotos de las noticias: solo se descargan la primera vez que se abre el desplegable
	document.querySelectorAll<HTMLElement>('.nav-item').forEach((li) => {
		const load = () => li.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((im) => { im.src = im.dataset.src!; im.removeAttribute('data-src'); });
		li.addEventListener('pointerenter', load, { once: true });
		li.addEventListener('focusin', load, { once: true });
	});
	// Panel lateral de ediciones: si no cabe a la derecha, se abre hacia la izquierda
	document.querySelectorAll<HTMLElement>('.has-fly').forEach((li) => {
		const fly = li.querySelector<HTMLElement>('.fly')!;
		const place = () => fly.classList.toggle('izq', li.getBoundingClientRect().right + fly.offsetWidth > document.documentElement.clientWidth - 8);
		li.addEventListener('pointerenter', place);
		li.addEventListener('focusin', place);
	});

	const t = document.querySelector<HTMLButtonElement>('.nav-toggle');
	t?.addEventListener('click', () => {
		const open = t.getAttribute('aria-expanded') !== 'true';
		t.setAttribute('aria-expanded', String(open));
		document.querySelector('.nav')?.classList.toggle('is-open', open);
	});
</script>

<style>
	.strip { background: var(--azul); color: #b9cde0; font-family: var(--f-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .09em; }
	.strip .wrap { display: flex; justify-content: space-between; gap: 1rem; padding-block: .45rem; }
	.strip-r { display: flex; gap: 1.2rem; }
	.strip a { text-decoration: none; }
	.strip a:hover { color: var(--naranja-vivo); }
	@media (max-width: 640px) { .strip-r { display: none; } }

	.nav { position: sticky; top: 0; z-index: 50; background: var(--papel); border-bottom: 1px solid var(--negro); }
	.nav-in { display: flex; align-items: center; gap: 2rem; height: 72px; }
	.nav-logo { height: 38px; display: flex; text-decoration: none; margin-right: auto; }
	.nav-menu { display: flex; align-items: center; gap: 1.6rem; height: 100%; }
	.nav-menu > ul { display: flex; height: 100%; margin: 0; padding: 0; list-style: none; }
	.nav-item { position: relative; display: flex; align-items: center; }
	.nav-item > a {
		display: flex; align-items: center; height: 100%; padding: 0 .85rem; text-decoration: none;
		font-weight: 600; font-size: .92rem; letter-spacing: -.005em; position: relative;
	}
	.nav-item > a::after { content: ''; position: absolute; left: .85rem; right: .85rem; bottom: -1px; height: 3px; background: var(--naranja); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
	.nav-item:hover > a::after, .nav-item > a[aria-current]::after { transform: scaleX(1); }
	.has-sub > a { padding-right: 1.5rem; }
	.has-sub > a::before { content: ''; position: absolute; right: .7rem; top: 50%; width: 5px; height: 5px; border-right: 1.5px solid; border-bottom: 1.5px solid; transform: translateY(-70%) rotate(45deg); opacity: .6; }
	.sub {
		position: absolute; top: 100%; left: 0; min-width: 230px; padding-top: 1px;
		opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .2s, transform .25s var(--ease), visibility 0s .25s;
	}
	.sub ul { margin: 0; padding: .4rem; list-style: none; background: var(--blanco); border: 1px solid var(--negro); box-shadow: var(--sombra); }
	.nav-item:hover .sub, .nav-item:focus-within .sub { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
	.sub a { display: block; padding: .5rem .7rem; text-decoration: none; font-size: .9rem; }
	.sub a:hover { background: var(--papel-2); }
	.sub .sep { margin-top: .3rem; padding-top: .3rem; border-top: 1px solid var(--linea); }
	/* Panel lateral (solo texto): ediciones de lo que se repite cada año */
	.has-fly { position: relative; }
	.has-fly > a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
	.has-fly > a::after { margin-left: auto; }
	.has-fly > a::after { content: ''; width: 5px; height: 5px; border-right: 1.5px solid; border-top: 1.5px solid; transform: rotate(45deg); opacity: .5; flex: none; }
	.has-fly:hover > a, .has-fly:focus-within > a { background: var(--papel-2); }
	.fly {
		position: absolute; left: 100%; top: calc(-.4rem - 1px); min-width: 230px; padding-left: .4rem;
		opacity: 0; visibility: hidden; transform: translateX(-6px); transition: opacity .18s, transform .22s var(--ease), visibility 0s .22s;
	}
	.fly::before { content: ''; position: absolute; inset: 0 auto 0 0; width: .4rem; } /* puente para no perder el hover */
	.has-fly:hover > .fly, .has-fly:focus-within > .fly { opacity: 1; visibility: visible; transform: none; transition-delay: .06s, .06s, 0s; }
	/* Sin ediciones: fuera del modo edición se comporta como un enlace normal */
	html:not(.is-admin) .fly-vacio > .fly, html:not(.is-admin) .fly-vacio > a::after { display: none; }
	html:not(.is-admin) .fly-vacio:hover > a { background: var(--papel-2); }
	.fly-vacio .sub-add a { margin-top: 0; }
	.fly.izq { left: auto; right: 100%; padding: 0 .4rem 0 0; transform: translateX(6px); }
	.fly.izq::before { inset: 0 0 0 auto; }

	/* Descripción corta debajo del título */
	.sub .desc { display: block; margin-top: .15rem; max-width: 30ch; font-size: .78rem; font-weight: 400; line-height: 1.3; color: var(--gris); }
	.has-fly > a:has(.desc)::after { align-self: center; }

	/* Última edición destacada (Octubre Robótico 2024) */
	.sub .t { display: block; min-width: 0; }
	/* «Destacar en el menú» (opcional) */
	.sub .resaltado > a { display: flex; align-items: baseline; gap: .5rem; background: var(--papel); box-shadow: inset 3px 0 0 var(--naranja); font-weight: 600; }
	.estrella { font-style: normal; font-size: .8em; color: var(--naranja); }

	/* Noticias: las últimas con su imagen */
	.sub-news { left: auto; right: 0; width: 380px; }
	.news-i a { display: grid; grid-template-columns: 110px 1fr; gap: .9rem; align-items: center; padding: .5rem; }
	.news-img { aspect-ratio: var(--a3); overflow: hidden; border: 1px solid var(--negro); background: var(--azul) linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px) 0 0 / 8px 8px; }
	.news-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s var(--ease); }
	.news-i a:hover img { transform: scale(1.05); }
	.news-txt { display: grid; gap: .25rem; min-width: 0; }
	.news-txt time { font-family: var(--f-mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .06em; color: var(--naranja); }
	.news-t { font-weight: 600; font-size: .88rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

	.sub-add a { font-family: var(--f-mono); font-size: .78rem; color: var(--naranja); text-transform: uppercase; letter-spacing: .05em; border: 1px dashed var(--naranja); margin-top: .35rem; }
	/* La sombra se queda en su sitio y crece al subir el botón, como en el resto de botones */
	.nav-cta { padding: .6rem 1rem; box-shadow: 3px 3px 0 var(--negro); }
	.nav-cta:hover { box-shadow: 5px 5px 0 var(--negro); }
	.nav-cta:active { box-shadow: 1px 1px 0 var(--negro); }
	.nav-toggle { display: none; }

	@media (max-width: 1080px) {
		.nav-toggle { display: grid; gap: 5px; width: 44px; height: 44px; place-content: center; border: 1px solid var(--negro); background: none; cursor: pointer; }
		.nav-toggle span:not(.sr-only) { width: 20px; height: 2px; background: var(--negro); transition: transform .25s var(--ease), opacity .2s; }
		.nav.is-open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
		.nav.is-open .nav-toggle span:nth-child(2) { opacity: 0; }
		.nav.is-open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
		.nav-menu { display: none; position: absolute; top: 100%; left: 0; right: 0; height: auto; max-height: calc(100vh - 72px); overflow-y: auto; flex-direction: column; align-items: stretch; padding: 1rem var(--gutter) 2rem; background: var(--papel); border-bottom: 1px solid var(--negro); }
		.nav.is-open .nav-menu { display: flex; }
		.nav-menu > ul { flex-direction: column; height: auto; }
		.nav-item { flex-direction: column; align-items: stretch; border-bottom: 1px solid var(--linea); }
		.nav-item > a { height: auto; padding: .9rem 0; font-size: 1.15rem; }
		.nav-item > a::after, .has-sub > a::before { display: none; }
		.sub { position: static; opacity: 1; visibility: visible; transform: none; padding: 0 0 .8rem; }
		.sub ul { border: 0; box-shadow: none; background: none; padding: 0; columns: 2; }
		.sub a { padding: .35rem 0; color: var(--gris); }
		.fly, .has-fly > a::after, .news-img { display: none; }
		.sub-news { width: auto; }
		.news-i a { display: block; padding: .35rem 0; }
		.news-txt time { display: none; }
		.news-t { font-weight: 400; color: var(--gris); }
		.nav-cta { align-self: flex-start; margin-top: 1rem; }
	}
</style>
