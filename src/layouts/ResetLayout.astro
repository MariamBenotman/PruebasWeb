---
import Navbar from '../components/Navbar.astro';

const { title = 'Reset - Asociación de Estudiantes' } = Astro.props;
const socialLinks = [
	{ name: 'Facebook', href: 'https://www.facebook.com/ResetETSII/' },
	{ name: 'Twitter', href: 'https://twitter.com/reset_etsii' },
	{ name: 'Instagram', href: 'https://www.instagram.com/aereset/' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#101c2a" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#content">Saltar al contenido</a>
		<Navbar />
		<main id="content">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand"><span>RESET</span><small>Asociación de Estudiantes · ETSII UPM</small></div>
				<div class="footer-links">
					{socialLinks.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.name}</a>)}
					<a href="mailto:aereset@gmail.com">Mail</a>
				</div>
				<p>© Copyright | Asociación de Estudiantes Reset | Todos los derechos reservados</p>
				<a class="back-to-top" href="#top" aria-label="Ir arriba">↑</a>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		font-family: 'Avenir Next', Avenir, 'Segoe UI', sans-serif;
		color: #172433;
		background: #f3f5f4;
		font-synthesis: none;
		--ink: #172433;
		--night: #101c2a;
		--blue: #006f8b;
		--orange: #e85d32;
		--paper: #f3f5f4;
		--muted: #65717a;
		--line: #d7dddf;
		--ease-out: cubic-bezier(.22, 1, .36, 1);
		--ease-snap: cubic-bezier(.2, .75, .25, 1);
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; background: var(--paper); }
	a { color: inherit; }
	button, input { font: inherit; }
	button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid #ff9a76; outline-offset: 3px; }
	.skip-link { position: absolute; top: -4rem; left: 1rem; z-index: 20; padding: .75rem 1rem; background: white; color: var(--ink); }
	.skip-link:focus { top: 1rem; }
	main { min-height: 65vh; }
	.site-footer { position: relative; color: #e8eff1; background: var(--night); border-top: 5px solid var(--orange); }
	.footer-inner { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 2rem; max-width: 1180px; margin: auto; padding: 2.5rem 1.5rem; }
	.footer-brand { display: grid; gap: .3rem; }
	.footer-brand span { color: #fff; font-size: 1.5rem; font-weight: 900; }
	.footer-brand small, .site-footer p { color: #b7c1c7; }
	.footer-links { display: flex; flex-wrap: wrap; align-content: start; gap: .8rem 1.2rem; }
	.footer-links a { color: white; text-decoration-color: #69818b; text-underline-offset: .25em; }
	.site-footer p { grid-column: 1 / -1; margin: 0; padding-top: 1rem; border-top: 1px solid #334351; font-size: .85rem; }
	.back-to-top { position: absolute; right: 1.5rem; bottom: 2.3rem; display: grid; place-items: center; width: 2.5rem; aspect-ratio: 1; border: 1px solid #70808b; border-radius: 50%; color: white; text-decoration: none; font-size: 1.25rem; }
	@media (max-width: 600px) { .footer-inner { grid-template-columns: 1fr; } .footer-links { padding-bottom: 1rem; } .site-footer p { padding-right: 3rem; } }
</style>