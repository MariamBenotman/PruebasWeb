---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import sitio from '../data/sitio.json';
import { href } from '../lib/data';

interface Props { title?: string; description?: string; /** Página oculta: que no la indexen los buscadores */ noindex?: boolean }
const { title, noindex = false, description = 'Asociación de Estudiantes Reset · ETSII-UPM. Robótica, electrónica, automática e informática. Organizadores de Cybertech.' } = Astro.props;
const fullTitle = title ? `${title} · Reset` : 'Reset · Asociación de Estudiantes ETSII-UPM';
const gh = sitio.github;
/** Vista previa de una rama (la compila GitHub en /ramas/<rama>/): sin modo edición y sin indexar */
const vistaPrevia: string = import.meta.env.PUBLIC_VISTA_PREVIA ?? '';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0b3558" />
		<meta name="description" content={description} />
		{(noindex || vistaPrevia) && <meta name="robots" content="noindex" />}
		<title>{fullTitle}</title>
		<!-- Icono de la pestaña: SVG sin fondo, negro en modo claro y blanco en modo oscuro (Chrome, Edge, Firefox). PNG para Safari. -->
		<link rel="icon" href={href('marca/favicon.png')} sizes="512x512" type="image/png" />
		<link rel="icon" href={href('marca/favicon.svg')} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<style set:html={`@font-face{font-family:'LTAtomatic';src:url('${href('fuentes/LTAtomatic.woff2')}') format('woff2');font-display:swap}:root{--marca-agua:url('${href('marca/reset-marca-agua.svg')}')}`}></style>
		<script is:inline define:vars={{ gh, base: href(''), local: import.meta.env.DEV, vistaPrevia }}>
			document.documentElement.classList.add('js');
			window.__site = { gh, base, local };
			try {
				// En local (astro dev) el modo edición está activo sin token, salvo que se haya pulsado "Salir".
				var on = local ? !localStorage.getItem('reset-local-off') : !!localStorage.getItem('reset-admin-token');
				// En una vista previa no se edita: guardaría en la web principal (main)
				if (on && !vistaPrevia) document.documentElement.classList.add('is-admin');
			} catch {}
			// Si una imagen no existe: prueba alternativas (data-fb="a|b"); si no, se quita y queda el hueco de reserva.
			window.__img = function (el) {
				if (window.__imgAdmin && window.__imgAdmin(el)) return;
				var fb = (el.getAttribute('data-fb') || '').split('|').filter(Boolean);
				if (fb.length) {
					el.src = fb.shift(); el.setAttribute('data-fb', fb.join('|'));
					if (el.parentElement && el.parentElement.classList.contains('frame')) el.parentElement.classList.add('es-prestada');
					return;
				}
				// (la foto de «al pasar el ratón» que falla no cuenta: la principal puede estar bien)
				var p = el.parentElement, alt = el.classList.contains('alt'); el.remove();
				if (p && !alt) { p.classList.add('is-missing'); p.classList.remove('es-prestada'); }
			};
		</script>
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>
		{vistaPrevia && <div class="vista-previa">Vista previa de la rama <b>{vistaPrevia}</b> · no es la web publicada</div>}
		<Navbar />
		<main id="contenido">
			<slot />
		</main>
		<Footer />
		<script>
			// Animación de aparición al hacer scroll. Lo que aparece a la vez entra en cascada según su
			// posición real en pantalla (fila a fila, de izquierda a derecha), sea cual sea el ancho de las filas.
			const io = new IntersectionObserver((entries) => {
				const vis = entries.filter((e) => e.isIntersecting);
				const fila = (e: IntersectionObserverEntry) => Math.round(e.boundingClientRect.top / 40);
				const filas = [...new Set(vis.map(fila))].sort((a, b) => a - b);
				for (const e of vis) {
					// columna = cuántos de su misma fila están más a la izquierda
					const col = vis.filter((x) => fila(x) === fila(e) && x.boundingClientRect.left < e.boundingClientRect.left).length;
					(e.target as HTMLElement).style.setProperty('--d', String(Math.min(filas.indexOf(fila(e)) * 2 + col, 14)));
					e.target.classList.add('is-in');
					io.unobserve(e.target);
				}
			}, { rootMargin: '0px 0px -8% 0px' });
			// Fotos "al pasar el ratón": están ocultas (recortadas), así que el navegador no las decodifica
			// hasta el primer hover y la animación llega antes que la foto. Se preparan al acercarse a la pantalla.
			const prep = new IntersectionObserver((entries) => {
				for (const e of entries) if (e.isIntersecting) {
					const im = e.target as HTMLImageElement;
					im.loading = 'eager';
					im.decode?.().catch(() => {});
					prep.unobserve(im);
				}
			}, { rootMargin: '400px 0px' });
			// Imágenes que no tienen la proporción de su marco (un cartel A3 vertical en una tarjeta apaisada…):
			// en vez de recortarlas, se ven enteras sobre un fondo hecho con la misma imagen desenfocada.
			const encajar = (im: HTMLImageElement) => {
				const fr = im.parentElement;
				if (!fr || !fr.classList.contains('frame') || fr.classList.contains('natural') || im.classList.contains('alt') || im.classList.contains('encaja-fondo') || !im.naturalWidth) return;
				const nat = im.naturalWidth / im.naturalHeight, box = fr.clientWidth / fr.clientHeight;
				const corta = 1 - Math.min(nat, box) / Math.max(nat, box) > 0.1;
				fr.classList.toggle('encaja', corta);
				const fondo = fr.querySelector(':scope > img.encaja-fondo');
				if (corta && !fondo) {
					const f = im.cloneNode() as HTMLImageElement;
					f.className = 'encaja-fondo'; f.alt = ''; f.removeAttribute('onerror'); f.setAttribute('aria-hidden', 'true');
					fr.insertBefore(f, im);
				} else if (!corta) fondo?.remove();
			};
			document.addEventListener('load', (e) => { if (e.target instanceof HTMLImageElement) encajar(e.target); }, true);
			const watch = () => {
				document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => io.observe(el));
				document.querySelectorAll('img.alt').forEach((el) => prep.observe(el));
				document.querySelectorAll<HTMLImageElement>('.frame > img').forEach((im) => im.complete && encajar(im));
			};
			watch();
			document.addEventListener('reset:rendered', watch);

			// Textos grandes: se mantienen a su tamaño (el máximo de su recuadro) y con las mismas líneas, pero repartidas
			// para que todas midan lo más parecido posible: «ROBÓTICA / HECHA POR / ESTUDIANTES» en vez de
			// «ROBÓTICA HECHA / POR / ESTUDIANTES». Se busca el ancho más estrecho en el que el texto sigue ocupando
			// las mismas líneas: así la línea más larga es lo más corta posible y el bloque queda compacto.
			const GRANDES = '.inicio .hero-t, .car-t, .about-big, .join .display, .pg-head h1, .en-t, .gp-t';
			const lineas = (el: HTMLElement) => {
				const cs = getComputedStyle(el);
				const lh = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.2;
				return Math.round(el.getBoundingClientRect().height / lh);
			};
			const ajustar = (el: HTMLElement) => {
				el.style.maxWidth = '';
				if (!el.offsetParent || !el.textContent?.trim()) return;
				const l0 = lineas(el);
				// Una línea: nada que repartir. Más de 5: es un párrafo, mejor que ocupe todo el ancho.
				if (l0 <= 1 || l0 > 5) return;
				let lo = 0, hi = el.getBoundingClientRect().width;
				for (let i = 0; i < 12 && hi - lo > 1; i++) {
					const mid = (lo + hi) / 2;
					el.style.maxWidth = `${mid}px`;
					// vale si no añade líneas y ninguna palabra se sale del ancho
					if (lineas(el) <= l0 && el.scrollWidth <= Math.ceil(mid)) hi = mid; else lo = mid;
				}
				el.style.maxWidth = `${Math.ceil(hi) + 1}px`;
			};
			let pendienteAjuste = 0;
			const ajustarTodo = () => { cancelAnimationFrame(pendienteAjuste); pendienteAjuste = requestAnimationFrame(() => document.querySelectorAll<HTMLElement>(GRANDES).forEach(ajustar)); };
			ajustarTodo();
			document.fonts?.ready.then(ajustarTodo);
			addEventListener('resize', ajustarTodo);
			document.addEventListener('reset:rendered', ajustarTodo);

			// Lo que solo se ve dentro de un plazo (p. ej. «Inscripciones abiertas» de Cybertech): data-plazo="desde|hasta"
			// Se decide aquí, en el navegador, con la fecha de hoy: aparece y desaparece solo, sin volver a publicar.
			const hoy = new Date();
			const hoyIso = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
			document.querySelectorAll<HTMLElement>('[data-plazo]').forEach((el) => {
				const [desde, hasta] = (el.dataset.plazo ?? '').split('|');
				el.hidden = !((!desde || desde <= hoyIso) && (!hasta || hoyIso <= hasta));
			});
			// «Este curso»: el curso académico va de septiembre a agosto (en noviembre de 2026 → «2026/27»).
			// Solo se marca si ese curso existe; si aún no se ha añadido, no se destaca ninguno.
			const y0 = hoy.getMonth() >= 8 ? hoy.getFullYear() : hoy.getFullYear() - 1;
			const cursoActual = `${y0}/${String((y0 + 1) % 100).padStart(2, '0')}`;
			document.querySelectorAll<HTMLElement>('[data-curso]').forEach((el) => { el.hidden = el.dataset.curso !== cursoActual; });

			// Resetero del mes: quien tenga el mes más reciente ya empezado de este curso (data-rdm="2026-11 2027-02" en su tarjeta).
			// Elegido el de noviembre, se destaca desde noviembre hasta que se elija el siguiente. Cada curso empieza de cero.
			const inicioCurso = `${y0}-09`, mesHoy = hoyIso.slice(0, 7);
			const marcarRdm = () => {
				const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-rdm]')];
				let ultimo = '';
				for (const t of tarjetas) for (const ym of (t.dataset.rdm ?? '').split(' ')) if (ym >= inicioCurso && ym <= mesHoy && ym > ultimo) ultimo = ym;
				for (const t of tarjetas) {
					const es = !!ultimo && (t.dataset.rdm ?? '').split(' ').includes(ultimo);
					t.classList.toggle('es-rdm', es);
				}
			};
			marcarRdm();
			document.addEventListener('reset:rendered', marcarRdm);

			// Fotos que van rotando ([data-rotar], p. ej. las fotos de grupo de un curso): cada 5 s, con fundido.
			// Se paran con el ratón encima, con la pestaña oculta o si el sistema pide menos movimiento; los puntos eligen una.
			const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
			let relojes: number[] = [];
			const rotar = () => {
				relojes.forEach(clearInterval); relojes = [];
				document.querySelectorAll<HTMLElement>('[data-rotar]').forEach((caja) => {
					const fotos = [...caja.children].filter((x): x is HTMLElement => x.classList.contains('frame'));
					const puntos = [...(caja.nextElementSibling?.querySelectorAll<HTMLButtonElement>('[data-i]') ?? [])];
					if (fotos.length < 2) return;
					let i = Math.max(0, fotos.findIndex((f) => f.classList.contains('is-on')));
					const ir = (n: number) => {
						i = (n + fotos.length) % fotos.length;
						fotos.forEach((f, k) => f.classList.toggle('is-on', k === i));
						puntos.forEach((p, k) => p.toggleAttribute('aria-current', k === i));
					};
					puntos.forEach((p, k) => p.addEventListener('click', () => ir(k)));
					let encima = false;
					caja.addEventListener('mouseenter', () => { encima = true; });
					caja.addEventListener('mouseleave', () => { encima = false; });
					if (!quieto) relojes.push(window.setInterval(() => { if (!encima && !document.hidden) ir(i + 1); }, 5000));
				});
			};
			rotar();
			document.addEventListener('reset:rendered', rotar);

			// Textos que no pueden salirse de su columna ([data-encajar], p. ej. el lema de la portada): si alguna palabra
			// no cabe con el tamaño elegido, se reduce la letra lo justo para que quepa
			const encajarTexto = () => {
				document.querySelectorAll<HTMLElement>('[data-encajar]').forEach((t) => {
					t.style.removeProperty('font-size');
					const base = parseFloat(getComputedStyle(t).fontSize);
					for (let k = 0.98; t.scrollWidth > t.clientWidth + 1 && k > 0.4; k -= 0.02) t.style.fontSize = `${base * k}px`;
				});
			};
			encajarTexto();
			addEventListener('resize', encajarTexto);
			document.fonts?.ready.then(encajarTexto);
			document.addEventListener('reset:rendered', encajarTexto);

			// Modo edición: solo se descarga si hay sesión iniciada
			if (document.documentElement.classList.contains('is-admin')) import('../admin/main');
		</script>
	</body>
</html>

<style is:global>
	.skip { position: absolute; left: 1rem; top: -4rem; z-index: 100; padding: .7rem 1rem; background: var(--negro); color: var(--blanco); }
	.skip:focus { top: 1rem; }
	.adm-only { display: none !important; }
	html.is-admin .adm-only { display: revert !important; }
</style>
